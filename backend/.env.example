PORT=4000
# MongoDB connection string (Local Docker or MongoDB Atlas for cloud production)
MONGO_URI=mongodb://root:password123@localhost:27017/mental_wellness?authSource=admin

# AI Service URL (FastAPI microservice). In production on Render/Railway, point to internal or live AI service URL
AI_SERVICE_URL=http://127.0.0.1:8001

# Optional AI keys for production chat
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

