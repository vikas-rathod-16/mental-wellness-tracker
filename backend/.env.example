PORT=4000
# Must include the root credentials set in docker-compose.yml + authSource=admin
MONGO_URI=mongodb://root:password123@localhost:27017/mental_wellness?authSource=admin

# Optional — if set, /chat will use real OpenAI replies.
# If left blank, chat.js still works using a simple built-in fallback.
OPENAI_API_KEY=your_openai_api_key_here
